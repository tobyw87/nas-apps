# Copied to .env by install.sh on first install (with fresh random secrets). Never commit .env.
HOST_PORT=8110
NEXTAUTH_URL=https://links.tobyw87.com/api/v1/auth
NEXTAUTH_SECRET=change-me
POSTGRES_PASSWORD=change-me
# Leave false until you've created your account, then set true and run: sudo docker compose up -d
NEXT_PUBLIC_DISABLE_REGISTRATION=false
