{
  "manifest_version": 2,
  "name": "Bookmark Bar Sync",
  "version": "1.0.1",
  "description": "Keeps the bookmarks bar in sync with a Linkwarden collection.",
  "permissions": [
    "bookmarks",
    "storage",
    "alarms",
    "__HOST__/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_title": "Bookmark Bar Sync",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-bar-sync@tobyw87.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "bookmarksInfo"
        ]
      }
    }
  }
}
