{
  "manifest_version": 3,
  "name": "Bookmark Bar Sync",
  "version": "1.0.0",
  "description": "Keeps the bookmarks bar in sync with a Linkwarden collection.",
  "permissions": ["bookmarks", "storage", "alarms"],
  "host_permissions": ["__HOST__/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_title": "Bookmark Bar Sync", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
