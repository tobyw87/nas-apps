# Serves the switch page and exposes exactly two calls to Home Assistant:
# read this one switch's state, and toggle it. The access token stays here, never in the page.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    add_header Cache-Control "no-store" always;

    location = / {
        try_files /index.html =404;
    }

    location = /state {
        limit_except GET { deny all; }
        proxy_pass http://host.docker.internal:8123/api/states/input_boolean.pc_audio_to_homepods;
        proxy_set_header Authorization "Bearer ${HA_TOKEN}";
    }

    location = /toggle {
        limit_except POST { deny all; }
        proxy_pass http://host.docker.internal:8123/api/services/input_boolean/toggle;
        proxy_method POST;
        proxy_set_header Authorization "Bearer ${HA_TOKEN}";
        proxy_set_header Content-Type "application/json";
        proxy_set_body '{"entity_id":"input_boolean.pc_audio_to_homepods"}';
    }

    location / {
        return 404;
    }
}
