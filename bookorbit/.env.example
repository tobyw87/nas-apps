# Copy of what setup.sh writes to .env on the NAS (secrets left blank here).
# setup.sh fills in random secrets and never overwrites an existing .env.

APP_IMAGE=ghcr.io/bookorbit/bookorbit:3.3.0
APP_PORT=3080
# URL you open in the browser: the Tailscale sidecar's HTTPS name.
APP_URL=https://bookorbit.taileefdd9.ts.net
TZ=America/Chicago

# The three 5_Books folders are mounted by docker-compose.yml (BookOrbit may edit files there):
#   5_Books/EPUB Archive -> /books, 5_Books/Textbooks -> /textbooks, 5_Books/Manga -> /manga
# Override with EPUB_DIR / TEXTBOOKS_DIR / MANGA_DIR (quote paths with spaces).

# Same user books-tools runs as (from /volume1/docker/books-tools/.env).
PUID=
PGID=

# The NAS has ~5.6 GB RAM shared with everything else; upstream default is 2048.
# 1024 ran out during the first scan of large Springer PDFs (Oct 9), so 1536.
# The container itself is capped at APP_MEM_LIMIT (default 2500m, in docker-compose.yml);
# heap plus image buffers for big CBZs went to 2.46 GB, so keep the cap ~1 GB above the heap.
NODE_MAX_OLD_SPACE_SIZE=1536

POSTGRES_USER=bookorbit
POSTGRES_DB=bookorbit
POSTGRES_PASSWORD=
JWT_SECRET=
PODCAST_ENCRYPTION_KEY=
SETUP_BOOTSTRAP_TOKEN=
# Encrypts the Gmail app password saved for Send-to-Kindle.
EMAIL_ENCRYPTION_KEY=

# Tailscale sidecar. Name on the tailnet -> https://<TS_HOSTNAME>.taileefdd9.ts.net
TS_HOSTNAME=bookorbit
# Auth key for the first login (Settings -> Keys; not reusable, not ephemeral).
TS_AUTHKEY=
