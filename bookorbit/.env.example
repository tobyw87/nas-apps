# Copy of what setup.sh writes to .env on the NAS (secrets left blank here).
# setup.sh fills in random secrets and never overwrites an existing .env.

APP_IMAGE=ghcr.io/bookorbit/bookorbit:3.3.0
APP_PORT=3080
# URL you open in the browser (Tailscale MagicDNS name of the NAS + APP_PORT).
APP_URL=http://treebeard.taileefdd9.ts.net:3080
TZ=America/Chicago

# books-tools Library, mounted read-only at /books.
LIBRARY_DIR=/volume1/NAS/Archive/5_Books/Library

# Same user books-tools runs as (from /volume1/docker/books-tools/.env).
PUID=
PGID=

# The NAS has ~5.6 GB RAM shared with everything else; upstream default is 2048.
NODE_MAX_OLD_SPACE_SIZE=1024

POSTGRES_USER=bookorbit
POSTGRES_DB=bookorbit
POSTGRES_PASSWORD=
JWT_SECRET=
PODCAST_ENCRYPTION_KEY=
SETUP_BOOTSTRAP_TOKEN=
# Encrypts the Gmail app password saved for Send-to-Kindle.
EMAIL_ENCRYPTION_KEY=
