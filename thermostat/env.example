# Home Assistant on Treebeard (same host network)
HA_URL=http://127.0.0.1:8123
# Long-lived access token: HA -> your profile -> Security -> Long-lived access tokens -> Create token
HA_TOKEN=
TZ=America/Chicago
# Local port (127.0.0.1 only)
HOST_PORT=8120
# Tailscale HTTPS port: https://treebeard.taileefdd9.ts.net:<this>/
TS_HTTPS_PORT=8445
# Optional: weather entity for the outdoor temperature (default: weather.forecast_home or the first weather.*)
# WEATHER_ENTITY=weather.forecast_home
